// A layout that puts the attention rail beside your work, in every tab.
//
// Use with:  zellij --layout agent-rail
// Or make it the default by copying to
//   ~/.config/zellij/layouts/default.kdl (Linux)
//   %USERPROFILE%\.config\zellij\layouts\default.kdl (Windows)

layout {
    new_tab_template {
        pane size=1 borderless=true {
            plugin location="zellij:tab-bar"
        }
        pane split_direction="vertical" {
            pane size=30 {
                plugin location="file:~/.config/zellij/plugins/agent-rail.wasm"
            }
            pane focus=true
        }
        pane size=2 borderless=true {
            plugin location="zellij:status-bar"
        }
    }
}
